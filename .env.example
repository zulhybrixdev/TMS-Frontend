VITE_API_BASE_URL=/api

# Leave unset for a client-facing POC build - the entire Platform Console
# (routes, pages, the /platform login) is then dead-code-eliminated from
# the bundle at build time, not just hidden from nav. Set to "true" only
# for internal/staff builds.
VITE_ENABLE_PLATFORM=

# Leave unset for a client-facing POC build - self-service registration
# (/register) and the billing/subscription-purchase flow (/billing/*,
# Administration > Subscription) are dead-code-eliminated too. /login is
# unaffected - that's the POC's own route in, using a pre-seeded account.
# Set to "true" for the full product build.
VITE_ENABLE_BILLING=

# Platform Console (dev tier only): where it reaches the uat / production APIs. Default to localhost;
# on a server set to http://<server-host>:4417/api and :5417/api.
# Platform Console reaches the dev backend same-origin through the Vite proxy; set this only if the console is served from somewhere else.
VITE_PLATFORM_DEV_API_BASE=
VITE_PLATFORM_UAT_API_BASE=
VITE_PLATFORM_PROD_API_BASE=
